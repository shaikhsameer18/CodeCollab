# Copy this file to .env and fill in real values.
# Never commit the real .env — it's gitignored on purpose.

# Port the server listens on
PORT=3000

# Comma-free, single origin the browser app is served from (used for CORS
# and for building OAuth redirect URLs)
FRONTEND_URL=http://localhost:5173

NODE_ENV=development

# Long, random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# GitHub OAuth App credentials (github.com/settings/developers)
# Authorization callback URL must be: <this server's public URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DeepInfra API key, used for the AI chat assistant (deepinfra.com)
DEEPINFRA_API_KEY=
