# Copy this file to .env (local dev) or set these in your host's dashboard
# (Vercel/Netlify/etc. for production). Never commit the real file.

# Base URL of the CodeCollab server (Socket.io, GitHub OAuth proxy, chatbot)
VITE_BACKEND_URL=http://localhost:3000

# Must match the GitHub OAuth App's client ID used by the server
VITE_GITHUB_CLIENT_ID=
